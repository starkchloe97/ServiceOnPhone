{
  "name": "service-on-phone",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 execute service-on-phone-db --local --file=database/schema.sql",
    "db:remote": "wrangler d1 execute service-on-phone-db --remote --file=database/schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name service-on-phone",
    "deploy:pages": "wrangler pages deploy dist --project-name service-on-phone"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7",
    "wrangler": "^4.154.0"
  }
}
